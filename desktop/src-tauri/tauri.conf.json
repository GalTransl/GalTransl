{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GalTransl Desktop",
  "version": "0.1.0",
  "identifier": "com.galtransl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GalTransl Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../plugins/": "plugins/",
      "../../Dict/": "Dict/",
      "../../translation_guidelines/": "translation_guidelines/",
      "../../res/": "res/"
    }
  }
}
